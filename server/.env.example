PORT=8000

# Redis (docker-compose: advance-rag-redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Qdrant (docker-compose: advance-rag-qdrant)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents

# Kafka (docker-compose: testflow-kafka)
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=testflow-rag
KAFKA_INDEXING_TOPIC=indexing-queue
KAFKA_QUERY_TOPIC=query-queue
KAFKA_INDEXING_GROUP_ID=indexing-workers
KAFKA_QUERY_GROUP_ID=query-workers

# Claude chat
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-20250514

# Embeddings — Voyage is Anthropic's recommended provider (no native Claude embedding API)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
RETRIEVAL_TOP_K=4
RRF_K=60
RETRIEVAL_FINAL_K=5
OPENROUTER_API_KEY=""
NVIDIA_API_KEY = ""